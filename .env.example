# Copy to .env.local (gitignored) and fill in from your Supabase project:
#   Dashboard -> Project Settings -> Data API  (URL)
#   Dashboard -> Project Settings -> API Keys  (publishable / anon key)
#
# Both values are PUBLIC. They ship in the JavaScript bundle, which is expected:
# every request they make is still checked by row level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER add the service-role key to this file or any other VITE_ variable.
# It bypasses row level security, and anything prefixed VITE_ is sent to the
# browser. It belongs only to a server you control.
